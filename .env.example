# Copy to .env and adjust. Docker Compose reads this file automatically.

# Owner of files written into ./data (see `id -u` / `id -g` on the host).
PUID=1000
PGID=1000

# Timezone for logs and timestamps.
TZ=Europe/Rome

# Published ports (bound to 127.0.0.1 in compose.yaml).
COMFYUI_PORT=8188
MCP_PORT=8080
MCP_PATH=/mcp
MCP_STATEFUL=true
MCP_DEBUG=false

# Extra ComfyUI launch flags, e.g. "--lowvram --preview-method auto".
COMFYUI_ARGS=

# ComfyUI git ref baked into the image. Pin a tag/commit for reproducibility.
COMFYUI_REF=v0.36.0

# Image to run. Point it at your ghcr.io namespace to consume published builds.
COMFYUI_IMAGE=comfyui-agent-stack:local

# Optional: partner-API models (Flux, Kling, Seedance, Gemini, ...) spend
# credits on Comfy's infrastructure. Uncomment the mapping in compose.yaml too.
# COMFY_API_KEY=comfyui-...
